{
  "name": "@queuebone/core",
  "version": "0.0.28",
  "description": "Node.js job queue",
  "keywords": [
    "queubone",
    "job-queue",
    "queue"
  ],
  "license": "MIT",
  "contributors": [
    "Initial minion.js: Sebastian Riedel <kraih@mojolicious.org>",
    "Jan Kunzmann <jan-github@phobia.de>"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@queuebone/development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./test-suite": {
      "@queuebone/development": "./src/test-suite.ts",
      "types": "./dist/test-suite.d.ts",
      "import": "./dist/test-suite.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./test-suite": {
        "types": "./dist/test-suite.d.ts",
        "import": "./dist/test-suite.js"
      }
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc -p ./tsconfig.build.json",
    "build:bench": "pnpm build && pnpm run bench",
    "build:clean": "pnpm clean && pnpm build",
    "build:coverage": "pnpm build && pnpm coverage",
    "build:node": "pnpm build && node",
    "build:watch": "pnpm build -- --watch",
    "clean": "rm -rf tsconfig*.tsbuildinfo dist",
    "coverage": "c8 tap --disable-coverage --allow-empty-coverage",
    "coverage:ci": "c8 --reporter lcovonly tap --disable-coverage --allow-empty-coverage",
    "lint": "eslint \"src/**/*.ts\" \"src/*.ts\"",
    "lint:fix": "pnpm lint -- --fix",
    "prepublishOnly": "pnpm build",
    "publish:minor": "pnpm version minor && pnpm publish --no-git-checks",
    "publish:patch": "pnpm version patch && pnpm publish --no-git-checks",
    "test": "tap --disable-coverage --allow-empty-coverage"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/tap": "^15.0.12",
    "@vitest/coverage-istanbul": "^2.1.8",
    "c8": "^10.1.3",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.2",
    "sort-package-json": "^2.12.0",
    "tap": "^21.0.1",
    "typescript": "~5.5.4",
    "typescript-eslint": "^8.18.1"
  },
  "packageManager": "pnpm@9.0.2+sha512.8bedf31de42705b97ff89330bbe177954ad5703a92fa894be0fb4d45b5dfab59a21f65a8419ad1cae82dd16fac2d41a8c343775e80efe7dab6d80b0408db2fd6",
  "engines": {
    "node": ">= 18"
  },
  "dependencies": {
    "tcompare": "^9.0.0"
  }
}
